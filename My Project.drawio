        <mxCell id="9R-u7DhIQNnBLEKmxpwn-24" parent="1" style="text;html=1;whiteSpace=wrap;overflow=hidden;rounded=0;" value="&lt;h1 style=&quot;margin-top: 0px;&quot;&gt;设计要点：&lt;/h1&gt;&lt;p&gt;1. CS端向BS端架构转变&lt;/p&gt;&lt;p&gt;2. 系统性能要求，90%-&amp;gt;100%可用&lt;/p&gt;&lt;p&gt;3. BOM中心剥离（BOM，价格）&lt;/p&gt;&lt;p&gt;4. BOM中心对接能力（接口/数据 设计预留）&lt;/p&gt;&lt;p&gt;5. 交期，价格 数据接口剥离&lt;/p&gt;&lt;p&gt;6. WMS 模块剥离&lt;/p&gt;&lt;p&gt;7. 数据校验前推，跳到拓扑拓&lt;/p&gt;" vertex="1">
          <mxGeometry height="240" width="270" x="500" y="420" as="geometry" />
        </mxCell>
        <mxCell id="9R-u7DhIQNnBLEKmxpwn-25" parent="1" style="text;html=1;whiteSpace=wrap;overflow=hidden;rounded=0;" value="&lt;h1 style=&quot;margin-top: 0px;&quot;&gt;设计要点：&lt;/h1&gt;&lt;p&gt;1. 图形-&amp;gt;NC的识别能力接口&lt;br&gt;&lt;/p&gt;&lt;p&gt;2. 其他问题待讨论后确定&lt;/p&gt;" vertex="1">
